<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <groupId>org.apache.maven.its.gh13762</groupId>
  <artifactId>reactor</artifactId>
  <version>1.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <modules>
    <module>a</module>
    <module>b</module>
  </modules>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.its.gh13762</groupId>
        <artifactId>probe-maven-plugin</artifactId>
        <version>1.0-SNAPSHOT</version>
        <executions>
          <!-- Every module, including this one, marks the completion of its package phase. -->
          <execution>
            <id>touch</id>
            <phase>package</phase>
            <goals>
              <goal>touch</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!-- Legacy form: an aggregator goal bound to a regular phase. -->
    <profile>
      <id>aggregator-flag</id>
      <build>
        <plugins>
          <plugin>
        <groupId>org.apache.maven.its.gh13762</groupId>
        <artifactId>probe-maven-plugin</artifactId>
            <executions>
              <execution>
                <id>probe</id>
                <phase>package</phase>
                <goals>
                  <goal>aggregator-probe</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>

    <!-- Migrated form exactly as in the example of section 3.3 of aggregator-goals.md. -->
    <profile>
      <id>after-all</id>
      <build>
        <plugins>
          <plugin>
        <groupId>org.apache.maven.its.gh13762</groupId>
        <artifactId>probe-maven-plugin</artifactId>
            <executions>
              <execution>
                <id>probe</id>
                <phase>after:all</phase>
                <goals>
                  <goal>probe</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>

    <!-- Migrated form with inheritance disabled, as required by section 3.2 of aggregator-goals.md. -->
    <profile>
      <id>after-all-not-inherited</id>
      <build>
        <plugins>
          <plugin>
        <groupId>org.apache.maven.its.gh13762</groupId>
        <artifactId>probe-maven-plugin</artifactId>
            <executions>
              <execution>
                <id>probe</id>
                <phase>after:all</phase>
                <goals>
                  <goal>probe</goal>
                </goals>
                <inherited>false</inherited>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>

    <!--
      Migrated form proposed instead of after:all: a Maven 4 goal that declares @After(phase = "package",
      type = CHILDREN), bound to the same phase as the legacy aggregator and without disabling inheritance.
    -->
    <profile>
      <id>after-children</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.its.gh13762</groupId>
            <artifactId>probe-v4-maven-plugin</artifactId>
            <version>1.0-SNAPSHOT</version>
            <executions>
              <execution>
                <id>probe</id>
                <phase>package</phase>
                <goals>
                  <goal>probe</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>

    <!-- Legacy form in the site lifecycle: an aggregator goal bound to site. -->
    <profile>
      <id>aggregator-flag-site</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.its.gh13762</groupId>
            <artifactId>probe-maven-plugin</artifactId>
            <version>1.0-SNAPSHOT</version>
            <executions>
              <execution>
                <id>probe</id>
                <phase>site</phase>
                <goals>
                  <goal>aggregator-probe</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>

    <!-- Proposed form in the site lifecycle: a Maven 4 goal with @After(phase = "site", type = CHILDREN). -->
    <profile>
      <id>after-children-site</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.its.gh13762</groupId>
            <artifactId>probe-v4-maven-plugin</artifactId>
            <version>1.0-SNAPSHOT</version>
            <executions>
              <execution>
                <id>probe</id>
                <phase>site</phase>
                <goals>
                  <goal>site-probe</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
